---
import { SITE } from '../data/site';
import ToastContainer from '../components/ToastContainer.astro';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/print.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `Recruiter Mode | ${SITE.name}`,
  description = SITE.description
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="day" data-motion="reduced">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    
    <!-- Preload only system/sans fonts (WOFF2) (M10) -->
    <link rel="preload" href="/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />

    <style>
      /* Recruiter specific overrides */
      body {
        background-color: var(--panel);
      }
      body::before {
        display: none; /* No dot grid */
      }
    </style>
  </head>
  <body>
    <div class="container container--recruiter">
      <div class="recruiter-topbar hide-on-print">
        <div class="recruiter-topbar-left">
          <a href="/">&larr; Return to Interactive Portfolio</a>
        </div>
        <div class="recruiter-topbar-right">
          <button class="btn-print" onclick="window.print()" type="button">
            <Icon name="copy" size={16} /> Print / Save PDF
          </button>
          <a href={SITE.links.resumePdf} class="btn-print" download>
            <Icon name="folder" size={16} /> Download Résumé
          </a>
        </div>
      </div>
      
      <main>
        <slot />
      </main>
    </div>

    <ToastContainer />

    <!-- Load achievements script so 'Efficient' achievement unlocks (M9) -->
    <script src="../scripts/achievements.ts"></script>
  </body>
</html>
