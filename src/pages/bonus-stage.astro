---
import BaseLayout from '../layouts/BaseLayout.astro';
import WipCard from '../components/WipCard.astro';
import { getCollection } from 'astro:content';

const allWips = await getCollection('wip');
const sortedWips = allWips.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Bonus Stage | Beerkanwar" noindex={true}>
  <section class="section section-bonus">
    <div style="padding-inline: var(--container-px);">
      <div class="section-header text-center">
        <h1 class="glitch" data-text="BONUS STAGE">BONUS STAGE</h1>
        <p class="section-desc">The Development Lab. Projects currently in active engineering.</p>
        <a href="/" class="btn btn-secondary" style="margin-top: 1rem;">&larr; Back to Main Game</a>
      </div>
      
      <div class="wip-grid-layout">
        {sortedWips.map(wip => (
          <WipCard wip={wip} />
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    setTimeout(() => {
      window.dispatchEvent(new CustomEvent('achievement-unlocked', { detail: { id: 'bonus-round' } }));
    }, 500);
  </script>
</BaseLayout>
