---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="404 | Game Over" noindex={true}>
  <section class="section section-404">
    <div class="container container--sm text-center">
      <h1 class="glitch" data-text="404">404</h1>
      <h2 style="margin-bottom: 2rem;">GAME OVER</h2>
      
      <p class="text-muted" style="margin-bottom: 3rem;">
        The coordinates you requested do not exist in this sector.
      </p>
      
      <!-- Mini game container will be injected via JS -->
      <div id="snake-404-container" class="snake-404-container hide-on-print">
        <canvas id="snake-404-canvas" width="400" height="400"></canvas>
        <div id="snake-404-overlay" class="snake-404-overlay">
          <button type="button" id="btn-start-snake" class="btn btn-primary">
            <Icon name="play" size={16} /> Play Snake
          </button>
        </div>
      </div>

      <div style="margin-top: 3rem;">
        <a href="/" class="btn btn-secondary">
          <Icon name="arrow-left" size={16} /> Return to Base
        </a>
      </div>
    </div>
  </section>

  <!-- Snake Mini-Game Script -->
  <script is:inline>
    // Extremely basic snake implementation for 404 page
    (function() {
      const canvas = document.getElementById('snake-404-canvas');
      const overlay = document.getElementById('snake-404-overlay');
      const btn = document.getElementById('btn-start-snake');
      if (!canvas || !overlay || !btn) return;
      
      const ctx = canvas.getContext('2d');
      const gridSize = 20;
      let snake = [];
      let apple = { x: 10, y: 10 };
      let dx = 1;
      let dy = 0;
      let score = 0;
      let gameInterval = null;

      function resetGame() {
        snake = [
          {x: 5, y: 5},
          {x: 4, y: 5},
          {x: 3, y: 5}
        ];
        dx = 1;
        dy = 0;
        score = 0;
        placeApple();
      }

      function placeApple() {
        let placed = false;
        while (!placed) {
          apple.x = Math.floor(Math.random() * (canvas.width / gridSize));
          apple.y = Math.floor(Math.random() * (canvas.height / gridSize));
          placed = true;
          for (let i = 0; i < snake.length; i++) {
            if (snake[i].x === apple.x && snake[i].y === apple.y) {
              placed = false;
              break;
            }
          }
        }
      }

      function gameLoop() {
        // Move
        const head = { x: snake[0].x + dx, y: snake[0].y + dy };
        
        // Wall collision
        if (head.x < 0 || head.x >= canvas.width / gridSize || head.y < 0 || head.y >= canvas.height / gridSize) {
          gameOver();
          return;
        }
        
        // Self collision
        for (let i = 0; i < snake.length; i++) {
          if (snake[i].x === head.x && snake[i].y === head.y) {
            gameOver();
            return;
          }
        }
        
        snake.unshift(head);
        
        // Apple collision
        if (head.x === apple.x && head.y === apple.y) {
          score++;
          placeApple();
          if (score === 10) {
            // Unlock achievement in real app, dispatch custom event
            window.dispatchEvent(new CustomEvent('achievement-unlocked', { detail: { id: 'snake-charmer' }}));
          }
        } else {
          snake.pop();
        }
        
        // Draw
        ctx.fillStyle = '#14172E'; // bg
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        ctx.fillStyle = '#F03A47'; // apple (red)
        ctx.fillRect(apple.x * gridSize, apple.y * gridSize, gridSize - 1, gridSize - 1);
        
        ctx.fillStyle = '#39E58A'; // snake (green)
        snake.forEach((seg) => {
          ctx.fillRect(seg.x * gridSize, seg.y * gridSize, gridSize - 1, gridSize - 1);
        });
        
        // Score
        ctx.fillStyle = '#9AA3C7';
        ctx.font = '16px "JetBrains Mono"';
        ctx.fillText(`Score: ${score}`, 10, 20);
      }

      function gameOver() {
        clearInterval(gameInterval);
        gameInterval = null;
        overlay.style.display = 'flex';
        btn.innerHTML = 'Game Over. Try Again?';
      }

      btn.addEventListener('click', () => {
        overlay.style.display = 'none';
        resetGame();
        if (gameInterval) clearInterval(gameInterval);
        gameInterval = setInterval(gameLoop, 100);
      });
      
      document.addEventListener('keydown', (e) => {
        if (!gameInterval) return;
        
        // Prevent default scrolling for arrows
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
          e.preventDefault();
        }
        
        if (e.key === 'ArrowUp' && dy !== 1) { dx = 0; dy = -1; }
        else if (e.key === 'ArrowDown' && dy !== -1) { dx = 0; dy = 1; }
        else if (e.key === 'ArrowLeft' && dx !== 1) { dx = -1; dy = 0; }
        else if (e.key === 'ArrowRight' && dx !== -1) { dx = 1; dy = 0; }
      });
      
      // Initial draw
      ctx.fillStyle = '#14172E';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    })();
  </script>
</BaseLayout>
