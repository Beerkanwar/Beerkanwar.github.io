---
---

<dialog id="modal-controls" class="pixel-modal">
  <div class="pixel-modal-header">
    <h3>Keyboard Shortcuts</h3>
    <button type="button" class="pixel-modal-close" data-close-modal aria-label="Close modal">&times;</button>
  </div>
  <div class="pixel-modal-body">
    <div class="shortcut-list">
      <div class="shortcut-row">
        <span class="shortcut-desc">Navigate Sections</span>
        <div class="shortcut-keys">
          <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> <kbd>4</kbd>
        </div>
      </div>
      <div class="shortcut-row">
        <span class="shortcut-desc">Open Achievements</span>
        <div class="shortcut-keys">
          <kbd>A</kbd>
        </div>
      </div>
      <div class="shortcut-row">
        <span class="shortcut-desc">Open Settings</span>
        <div class="shortcut-keys">
          <kbd>S</kbd>
        </div>
      </div>
      <div class="shortcut-row">
        <span class="shortcut-desc">Toggle Audio</span>
        <div class="shortcut-keys">
          <kbd>M</kbd>
        </div>
      </div>
      <div class="shortcut-row">
        <span class="shortcut-desc">Close Modal</span>
        <div class="shortcut-keys">
          <kbd>Esc</kbd>
        </div>
      </div>
      <div class="shortcut-row">
        <span class="shortcut-desc">Konami Code</span>
        <div class="shortcut-keys">
          <kbd>&uarr;</kbd> <kbd>&uarr;</kbd> <kbd>&darr;</kbd> <kbd>&darr;</kbd> <kbd>&larr;</kbd> <kbd>&rarr;</kbd> <kbd>&larr;</kbd> <kbd>&rarr;</kbd> <kbd>B</kbd> <kbd>A</kbd>
        </div>
      </div>
    </div>
  </div>
</dialog>
