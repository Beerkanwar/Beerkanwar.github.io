---
interface Props {
  name: string;
  size?: 16 | 24 | 32;
  label?: string;
}

const { name, size = 16, label } = Astro.props;
const hasLabel = !!label;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden={!hasLabel ? 'true' : undefined}
  aria-label={hasLabel ? label : undefined}
  role={hasLabel ? 'img' : undefined}
  class="icon"
>
  {name === 'coin' && (
    <Fragment>
      <rect x="5" y="1" width="6" height="1" />
      <rect x="4" y="2" width="1" height="1" /><rect x="11" y="2" width="1" height="1" />
      <rect x="3" y="3" width="1" height="10" /><rect x="12" y="3" width="1" height="10" />
      <rect x="4" y="3" width="8" height="10" fill="currentColor" opacity="0.3" />
      <rect x="7" y="3" width="2" height="10" opacity="0.15" />
      <rect x="4" y="13" width="1" height="1" /><rect x="11" y="13" width="1" height="1" />
      <rect x="5" y="14" width="6" height="1" />
    </Fragment>
  )}
  {name === 'star' && (
    <Fragment>
      <rect x="7" y="1" width="2" height="2" />
      <rect x="6" y="3" width="4" height="1" />
      <rect x="2" y="4" width="12" height="2" />
      <rect x="3" y="6" width="10" height="1" />
      <rect x="4" y="7" width="8" height="1" />
      <rect x="4" y="8" width="3" height="1" /><rect x="9" y="8" width="3" height="1" />
      <rect x="3" y="9" width="3" height="1" /><rect x="10" y="9" width="3" height="1" />
      <rect x="2" y="10" width="3" height="1" /><rect x="11" y="10" width="3" height="1" />
      <rect x="1" y="11" width="3" height="2" /><rect x="12" y="11" width="3" height="2" />
    </Fragment>
  )}
  {name === 'heart' && (
    <Fragment>
      <rect x="2" y="3" width="3" height="2" /><rect x="8" y="3" width="3" height="2" />
      <rect x="1" y="5" width="5" height="2" /><rect x="7" y="5" width="5" height="2" />
      <rect x="1" y="7" width="14" height="2" />
      <rect x="2" y="9" width="12" height="1" />
      <rect x="3" y="10" width="10" height="1" />
      <rect x="4" y="11" width="8" height="1" />
      <rect x="5" y="12" width="6" height="1" />
      <rect x="6" y="13" width="4" height="1" />
      <rect x="7" y="14" width="2" height="1" />
    </Fragment>
  )}
  {name === 'trophy' && (
    <Fragment>
      <rect x="4" y="1" width="8" height="2" />
      <rect x="2" y="3" width="12" height="1" />
      <rect x="1" y="4" width="2" height="3" /><rect x="13" y="4" width="2" height="3" />
      <rect x="3" y="4" width="10" height="4" />
      <rect x="2" y="7" width="2" height="1" /><rect x="12" y="7" width="2" height="1" />
      <rect x="4" y="8" width="8" height="1" />
      <rect x="5" y="9" width="6" height="1" />
      <rect x="6" y="10" width="4" height="1" />
      <rect x="7" y="11" width="2" height="2" />
      <rect x="5" y="13" width="6" height="2" />
    </Fragment>
  )}
  {name === 'gear' && (
    <Fragment>
      <rect x="6" y="0" width="4" height="2" />
      <rect x="4" y="2" width="8" height="1" />
      <rect x="3" y="3" width="10" height="1" />
      <rect x="2" y="4" width="2" height="2" /><rect x="12" y="4" width="2" height="2" />
      <rect x="0" y="6" width="2" height="4" /><rect x="14" y="6" width="2" height="4" />
      <rect x="5" y="5" width="6" height="6" />
      <rect x="7" y="7" width="2" height="2" fill="var(--panel, #181C36)" />
      <rect x="2" y="10" width="2" height="2" /><rect x="12" y="10" width="2" height="2" />
      <rect x="3" y="12" width="10" height="1" />
      <rect x="4" y="13" width="8" height="1" />
      <rect x="6" y="14" width="4" height="2" />
    </Fragment>
  )}
  {name === 'bolt' && (
    <Fragment>
      <rect x="8" y="1" width="4" height="2" />
      <rect x="7" y="3" width="4" height="2" />
      <rect x="6" y="5" width="4" height="1" />
      <rect x="4" y="6" width="8" height="2" />
      <rect x="6" y="8" width="4" height="1" />
      <rect x="5" y="9" width="4" height="2" />
      <rect x="4" y="11" width="4" height="2" />
      <rect x="3" y="13" width="4" height="2" />
    </Fragment>
  )}
  {name === 'arrow-right' && (
    <Fragment>
      <rect x="2" y="7" width="10" height="2" />
      <rect x="9" y="4" width="2" height="3" />
      <rect x="9" y="9" width="2" height="3" />
      <rect x="11" y="5" width="2" height="6" />
      <rect x="13" y="7" width="1" height="2" />
    </Fragment>
  )}
  {name === 'arrow-left' && (
    <Fragment>
      <rect x="4" y="7" width="10" height="2" />
      <rect x="5" y="4" width="2" height="3" />
      <rect x="5" y="9" width="2" height="3" />
      <rect x="3" y="5" width="2" height="6" />
      <rect x="2" y="7" width="1" height="2" />
    </Fragment>
  )}
  {name === 'arrow-up' && (
    <Fragment>
      <rect x="7" y="2" width="2" height="12" />
      <rect x="5" y="3" width="2" height="3" />
      <rect x="9" y="3" width="2" height="3" />
      <rect x="3" y="4" width="2" height="3" />
      <rect x="11" y="4" width="2" height="3" />
    </Fragment>
  )}
  {name === 'play' && (
    <Fragment>
      <rect x="4" y="2" width="2" height="12" />
      <rect x="6" y="3" width="2" height="10" />
      <rect x="8" y="4" width="2" height="8" />
      <rect x="10" y="5" width="2" height="6" />
      <rect x="12" y="6" width="1" height="4" />
    </Fragment>
  )}
  {name === 'controller' && (
    <Fragment>
      <rect x="4" y="4" width="8" height="8" />
      <rect x="2" y="5" width="2" height="6" />
      <rect x="12" y="5" width="2" height="6" />
      <rect x="1" y="7" width="1" height="3" />
      <rect x="14" y="7" width="1" height="3" />
      <rect x="5" y="7" width="1" height="3" fill="var(--panel, #181C36)" />
      <rect x="4" y="8" width="3" height="1" fill="var(--panel, #181C36)" />
      <rect x="11" y="7" width="1" height="1" fill="var(--panel, #181C36)" />
      <rect x="12" y="8" width="1" height="1" fill="var(--panel, #181C36)" />
    </Fragment>
  )}
  {name === 'folder' && (
    <Fragment>
      <rect x="1" y="3" width="5" height="2" />
      <rect x="1" y="5" width="14" height="9" />
      <rect x="2" y="6" width="12" height="1" fill="var(--panel, #181C36)" />
    </Fragment>
  )}
  {name === 'key' && (
    <Fragment>
      <rect x="5" y="1" width="4" height="1" />
      <rect x="4" y="2" width="1" height="4" /><rect x="9" y="2" width="1" height="4" />
      <rect x="5" y="2" width="4" height="4" fill="var(--panel, #181C36)" />
      <rect x="6" y="3" width="2" height="1" />
      <rect x="5" y="6" width="4" height="1" />
      <rect x="6" y="7" width="2" height="5" />
      <rect x="8" y="9" width="2" height="1" />
      <rect x="8" y="11" width="2" height="1" />
      <rect x="6" y="12" width="2" height="2" />
    </Fragment>
  )}
  {name === 'lock' && (
    <Fragment>
      <rect x="5" y="1" width="6" height="1" />
      <rect x="4" y="2" width="2" height="4" /><rect x="10" y="2" width="2" height="4" />
      <rect x="3" y="6" width="10" height="9" />
      <rect x="7" y="9" width="2" height="3" />
    </Fragment>
  )}
  {name === 'check' && (
    <Fragment>
      <rect x="12" y="3" width="2" height="2" />
      <rect x="11" y="5" width="2" height="2" />
      <rect x="10" y="6" width="2" height="2" />
      <rect x="9" y="7" width="2" height="2" />
      <rect x="3" y="7" width="2" height="2" />
      <rect x="4" y="9" width="2" height="2" />
      <rect x="5" y="8" width="2" height="2" />
      <rect x="7" y="8" width="2" height="2" />
    </Fragment>
  )}
  {name === 'copy' && (
    <Fragment>
      <rect x="5" y="1" width="9" height="1" />
      <rect x="5" y="1" width="1" height="10" /><rect x="13" y="1" width="1" height="10" />
      <rect x="5" y="11" width="9" height="1" />
      <rect x="2" y="4" width="1" height="10" /><rect x="11" y="4" width="1" height="1" />
      <rect x="2" y="14" width="10" height="1" />
      <rect x="2" y="4" width="3" height="1" />
      <rect x="11" y="12" width="1" height="2" />
    </Fragment>
  )}
  {name === 'external-link' && (
    <Fragment>
      <rect x="1" y="3" width="10" height="1" />
      <rect x="1" y="3" width="1" height="11" /><rect x="11" y="3" width="1" height="11" />
      <rect x="1" y="13" width="11" height="1" />
      <rect x="8" y="1" width="6" height="1" />
      <rect x="13" y="1" width="1" height="6" />
      <rect x="12" y="3" width="1" height="1" />
      <rect x="11" y="4" width="1" height="1" />
      <rect x="10" y="5" width="1" height="1" />
      <rect x="9" y="6" width="1" height="1" />
      <rect x="8" y="7" width="1" height="1" />
      <rect x="7" y="8" width="1" height="1" />
    </Fragment>
  )}
  {name === 'github' && (
    <Fragment>
      <rect x="5" y="1" width="6" height="1" />
      <rect x="3" y="2" width="2" height="1" /><rect x="11" y="2" width="2" height="1" />
      <rect x="2" y="3" width="1" height="6" /><rect x="13" y="3" width="1" height="6" />
      <rect x="3" y="3" width="10" height="6" fill="currentColor" />
      <rect x="4" y="4" width="2" height="2" fill="var(--panel, #181C36)" />
      <rect x="10" y="4" width="2" height="2" fill="var(--panel, #181C36)" />
      <rect x="3" y="9" width="10" height="1" />
      <rect x="4" y="10" width="3" height="1" /><rect x="9" y="10" width="3" height="1" />
      <rect x="1" y="9" width="2" height="3" /><rect x="13" y="9" width="2" height="3" />
      <rect x="3" y="11" width="2" height="2" /><rect x="11" y="11" width="2" height="2" />
      <rect x="5" y="12" width="2" height="2" /><rect x="9" y="12" width="2" height="2" />
      <rect x="6" y="13" width="4" height="1" />
    </Fragment>
  )}
  {name === 'linkedin' && (
    <Fragment>
      <rect x="2" y="2" width="12" height="12" />
      <rect x="4" y="4" width="2" height="2" fill="var(--panel, #181C36)" />
      <rect x="4" y="7" width="2" height="5" fill="var(--panel, #181C36)" />
      <rect x="7" y="7" width="2" height="5" fill="var(--panel, #181C36)" />
      <rect x="9" y="8" width="2" height="4" fill="var(--panel, #181C36)" />
      <rect x="9" y="6" width="2" height="2" fill="var(--panel, #181C36)" />
    </Fragment>
  )}
  {name === 'itch' && (
    <Fragment>
      <rect x="1" y="2" width="14" height="2" />
      <rect x="2" y="4" width="3" height="3" /><rect x="6" y="4" width="4" height="3" /><rect x="11" y="4" width="3" height="3" />
      <rect x="2" y="7" width="12" height="6" />
      <rect x="5" y="9" width="6" height="3" fill="var(--panel, #181C36)" />
      <rect x="6" y="10" width="4" height="1" />
    </Fragment>
  )}
  {name === 'google-play' && (
    <Fragment>
      <rect x="3" y="2" width="2" height="12" />
      <rect x="5" y="3" width="2" height="10" />
      <rect x="7" y="4" width="2" height="8" />
      <rect x="9" y="5" width="2" height="6" />
      <rect x="11" y="6" width="2" height="4" />
    </Fragment>
  )}
  {name === 'mail' && (
    <Fragment>
      <rect x="1" y="3" width="14" height="1" />
      <rect x="1" y="3" width="1" height="10" /><rect x="14" y="3" width="1" height="10" />
      <rect x="1" y="12" width="14" height="1" />
      <rect x="2" y="4" width="2" height="1" /><rect x="12" y="4" width="2" height="1" />
      <rect x="4" y="5" width="2" height="1" /><rect x="10" y="5" width="2" height="1" />
      <rect x="6" y="6" width="4" height="2" />
    </Fragment>
  )}
  {name === 'volume-on' && (
    <Fragment>
      <rect x="2" y="5" width="3" height="6" />
      <rect x="5" y="4" width="1" height="8" />
      <rect x="6" y="3" width="1" height="10" />
      <rect x="7" y="2" width="1" height="12" />
      <rect x="10" y="5" width="1" height="1" /><rect x="10" y="10" width="1" height="1" />
      <rect x="11" y="4" width="1" height="2" /><rect x="11" y="10" width="1" height="2" />
      <rect x="12" y="3" width="1" height="3" /><rect x="12" y="10" width="1" height="3" />
      <rect x="13" y="5" width="1" height="6" />
    </Fragment>
  )}
  {name === 'volume-off' && (
    <Fragment>
      <rect x="2" y="5" width="3" height="6" />
      <rect x="5" y="4" width="1" height="8" />
      <rect x="6" y="3" width="1" height="10" />
      <rect x="7" y="2" width="1" height="12" />
      <rect x="10" y="5" width="1" height="2" /><rect x="13" y="5" width="1" height="2" />
      <rect x="11" y="7" width="2" height="2" />
      <rect x="10" y="9" width="1" height="2" /><rect x="13" y="9" width="1" height="2" />
    </Fragment>
  )}
</svg>
