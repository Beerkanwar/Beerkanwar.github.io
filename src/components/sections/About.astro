---
import { SITE } from '../../data/site';
import Icon from '../Icon.astro';
import Coin from '../Coin.astro';
---

<section class="section section-about" id="about">
  <div class="container container--sm">
    <div class="section-header">
      <h2 class="section-title">Player Profile</h2>
      <p class="section-desc">Hardware specs and background initialization logs.</p>
    </div>

    <div class="about-grid">
      <!-- Player Card -->
      <div class="player-card">
        <div class="player-avatar-frame">
          <img src="/media/portrait.png" alt="Beerkanwar Singh" class="player-avatar-svg" style="width: 160px; height: 160px; object-fit: cover;" />
          <div class="coin-container-avatar"><Coin id={4} locationHint="Inside Player Avatar Frame" /></div>
        </div>
        
        <div class="player-info">
          <h3 class="player-name">{SITE.name}</h3>
          <div class="player-badge">
            <Icon name="gear" size={16} /> Systems / Gameplay
          </div>
          
          <dl class="player-stats">
            <dt>Location</dt>
            <dd>{SITE.location}</dd>
            
            <dt>Education</dt>
            <dd>B.Tech CSE @ NIT Jalandhar</dd>
            
            <dt>Status</dt>
            <dd>Open for Internships</dd>
          </dl>
        </div>
      </div>

      <!-- Bio -->
      <div class="player-bio">
        <p>
          I am a systems-oriented engineer obsessed with how things work under the hood. 
          While I love designing engaging game loops in Unity, I am equally passionate about 
          architecting the backend services, databases, and APIs that support them.
        </p>
        <p>
          My development philosophy relies on strict constraints: I write C# and Node.js code 
          that avoids unnecessary abstractions, minimizing GC spikes and keeping memory profiles lean. 
          I frequently implement custom object pools, deterministic data structures, and custom ML pipelines using Python.
        </p>
        <p>
          When I'm not studying at NIT Jalandhar or participating in Game Jams, I am likely 
          breaking down classic game mechanics, learning low-level C++, or optimizing 
          full-stack applications.
        </p>
      </div>
    </div>
  </div>
</section>
