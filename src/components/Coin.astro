---
interface Props {
  id: number;
  locationHint: string;
}

const { id, locationHint } = Astro.props;
---

<button 
  type="button" 
  class="pixel-coin" 
  data-coin-id={id}
  aria-label={`Collect hidden coin ${id} of 7`}
  title={locationHint}
>
  <span class="pixel-coin-sprite"></span>
</button>
